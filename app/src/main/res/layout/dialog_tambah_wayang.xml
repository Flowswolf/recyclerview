<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etNamaWayang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nama Wayang"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/etKarakterWayang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Karakter (misal: Ksatria Pandawa)"
        android:inputType="text" />

    <EditText
        android:id="@+id/etDeskripsiWayang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Deskripsi Wayang"
        android:inputType="textMultiLine"
        android:minLines="2" />

    <EditText
        android:id="@+id/etFotoWayang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="URL Gambar (kosongkan jika default)"
        android:inputType="textUri" />

</LinearLayout>