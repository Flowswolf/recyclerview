<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:id="@+id/itemWayang">

    <ImageView
        android:id="@+id/gambarWayang"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:src="@drawable/androidimage" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/namaWayang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="namaWayang"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/karakterWayang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="karakterWayang"
            android:textColor="#00796B" />

        <TextView
            android:id="@+id/deskripsiWayang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="deskripsiWayang" />

    </LinearLayout>

</LinearLayout>